---
import Layout from '../../layouts/layout.astro';
---

<Layout >
	<section id="heroSection" class="h-screen relative">
		<div class="container mx-auto h-full relative z-30">
			<div class="flex flex-col items-center justify-center h-full w-full">
				<div class="rich-text w-full max-w-screen-md ml-auto p-8 bg-white/10 border-[3px] border-sand shadow-lg rotate-[-3deg]">
					<div class="rotate-3">
						<h1 class="text-3xl font-bold text-white mb-4 lg:mb-8 text-right">MI <span class="text-sand">Performance Assessment Cadre</span></h1>
						<div class="text-left">
							<p class="mt-4 mb-6 text-white/80 text-xl leading-tight"><span class="text-sand">MI Performance Assessment Cadre</span> is a non-profit organization that provides resources and support to English Language Arts and Mathematics educators in the Michigan area.</p>
							<p class="mb-6 text-md text-white/80">This project called for a custom, interactive AJAX resource library, custom Craft CMS configuration, Reporting and Analytics, Custom Download Tracking System, and more.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="w-[100vw] h-[100vh] absolute top-0 right-0 shadow-lg z-10">
			<div class="w-full h-full absolute top-0 left-0 z-30 bg-black/90"></div>
			<img src="../images/mipac.net_.png" alt="MI Performance Assessment Cadre desktop screenshot" class="w-full h-full object-cover">
		</div>
	</section>
</Layout>
