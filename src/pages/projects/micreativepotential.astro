---
import Layout from '../../layouts/layout.astro';
---

<Layout >
	<section id="heroSection" class="h-screen relative">
		<div class="container mx-auto h-full relative z-30">
			<div class="flex flex-col items-center justify-center h-full w-full">
				<div class="rich-text w-full max-w-screen-md ml-auto p-8 xl:p-16 bg-white/10 border-[3px] border-sand shadow-lg rotate-[-3deg]">
					<div class="rotate-3">
						<h1 class="text-3xl font-bold text-white mb-4 lg:mb-8 text-right">MI <span class="text-sand">Creative Potential</span></h1>
						<div class="text-left">
							<p class="mt-4 mb-6 text-white/80 text-xl leading-tight"><span class="text-sand">Michigan Creative Potential</span> is a non-profit organization that provides resources and support to creative educators in the Michigan area.</p>
							<p class="mb-6 text-md xl:text-base text-white/80">This project called for a custom Craft CMS website built with Tailwind CSS, jQuery, and PHP (Twig). Custom configuration of CKEditor, custom tools and fields with NEOS, custom templates, custom fields.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="w-[100dvw] h-[100dvh] absolute top-0 right-0 shadow-lg z-10">
			<div class="w-full h-full absolute top-0 left-0 z-30 bg-black/90"></div>
			<img src="../images/micreativepotential.org_.png" alt="MI Creative Potential desktop screenshot" class="w-full h-full object-cover">
		</div>
	</section>
</Layout>
