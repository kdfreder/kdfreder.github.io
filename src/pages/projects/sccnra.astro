---
import Layout from '../../layouts/layout.astro';
---

<Layout>
	<section id="heroSection" class="h-screen relative">
		<div class="container mx-auto h-full relative z-30">
			<div class="flex flex-col items-center justify-center h-full w-full">
				<div class="rich-text w-full max-w-screen-md ml-auto p-8 bg-white/10 border-[3px] border-sand shadow-lg rotate-[-3deg]">
					<div class="rotate-3">
						<h1 class="text-3xl font-bold text-white mb-4 lg:mb-8 text-right">SCC <span class="text-sand">NRA Tradeshow Application</span></h1>
						<div class="text-left">
							<p class="mt-4 mb-6 text-white/80 text-xl leading-tight"><span class="text-sand">Structural Concepts Corporation</span> is a leader in retail and food-service display, providing custom fixtures and displays for both industries.</p>
							<p class="mb-6 text-md text-white/80">This project called for a custom TypeScript application embedded in a website further integrated with Craft CMS. The application was created to show tradeshow hotspots and other information to attendees.</p>
						</div>
					</div>
				</div>
			</div>	
		</div>
		<div class="w-[100vw] h-[100vh] absolute top-0 right-0 shadow-lg z-10">
			<div class="w-full h-full absolute top-0 left-0 z-30 bg-black/90"></div>
			<img src="../images/structuralconcepts.com_nra_.png" alt="SCC NRA Tradeshow Application desktop screenshot" class="w-full h-full object-cover">
		</div>
	</section>
</Layout>
