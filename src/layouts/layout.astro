---
import Header from './header.astro';
import Footer from './footer.astro';
import '../styles/global.css';

export interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>Kyle Frederick | Senior Front End Engineer & SEO Consultant</title>
    <meta name="description" content="Kyle Frederick is a senior front end engineer and SEO consultant with a passion for building websites that are both functional and aesthetically pleasing." />
    <meta name="keywords" content="Kyle Frederick, front end engineer, SEO consultant, website designer, website developer, website optimization, website performance" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/images/favicon2.png" />
  </head>
  <body x-data="snapScroll">
    <Header currentPage={currentPage} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
    <script src="/global.js" is:inline></script>
  </body>
</html>
